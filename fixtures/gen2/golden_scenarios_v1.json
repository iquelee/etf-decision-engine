      },
      "gap_to_close": [
        "Python 需 rankings 与 config 两个额外入参 → 适配器需从 canonical panel 派生 rankings 并显式加载 config",
        "两侧 rank/percentile 与 trend_gate 的派生必须来自同一 canonical 输入，禁止各自造数",
        "解锁后方可运行 G2S-07（晋升连续性 / NO_CORE）"
      ],
      "status": "SPEC_ONLY（契约已定义；可执行适配器为 WP-G2-03 剩余切片）"
    },
    "run_status_gate": {
      "purpose": "Gen-2 run 状态四态契约（G2S-06 依赖）。",
      "states": {
        "running": "已开始、尚未发布完整横截面（消费者不得读取）",
        "completed": "唯一可消费状态；必须满足唯一 code / universe_count / 输出哈希校验",
        "blocked": "数据、资格、约束不通过 → 今日没有可信 Gen-2 结果（可预期业务结果；前台只展示 V3.6.1）",
        "failed": "代码、网络、数据库等运行异常 → 系统未正常完成"
      },
      "rules": [
        "blocked 与 failed 不得合并，文案与告警必须区分",
        "数据闸门（BENCHMARK_MISSING / BENCHMARK_INSUFFICIENT_HISTORY / STALE_BATCH / NO_ELIGIBLE_TODAY）→ blocked",
        "发布前完整性校验失败（唯一 code / 非有限 alpha / 写入 0 行）→ blocked",
        "未捕获异常（代码 / 网络 / DB）→ failed",
        "任何非 completed 状态都不得被前台消费为建议"
      ],
      "status": "IMPLEMENTED（runGen2ShadowEod；G2S-06 的场景化验证待 roles/run 闸门场景切片）"
    }
