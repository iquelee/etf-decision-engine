    "layer_contract": {
      "input": "固定输入（双端共用同一份；结构化输入由各自 adapter 转成该端形态，adapter 差异必须显式记录）",
      "invariants": "已确认的业务不变量（唯一 expected 只能来自这里，禁止把任一端现有输出写成 expected）",
      "observations": "双端实际输出，由 scripts/parity/run_gen2_scenarios_{node.js,py} 生成，不预先填写"
    },
    "gate": "0 个未记录、未定位的差异；允许已登记并定位的 EXPLAINED / PENDING_RULING 项",
    "forbidden": [
      "不得为达成 0 差异而修改任一端规则/参数",
      "不得把 Python 或 JS 任一现有输出当作唯一真值",
      "不得在本包内改动 bundle / lock / 生产库 / 部署 / authority"
    ]
  },
  "classification_vocabulary": {
    "ALIGNED": "两端输出一致",
    "EXPLAINED": "两端不一致但已定位到具体代码位置且有依据（adapter/接口差异等），不阻塞",
    "PENDING_RULING": "两端都实现了同一语义但结果不同 → 需要业务裁决（本包不修，下一包决定）",
    "EXCLUDED_BY_DESIGN": "某一端按设计不实现该概念（必须写明原因与位置）"
  },
  "seam_contracts": {
    "roles_panel": {
      "purpose": "roles 状态机（晋升连续性 / NO_CORE / 角色最终约束）的共同输入契约；G2S-07 依赖本契约的可执行适配器。",
      "canonical_input": {
        "panel_rows": "每行 = (trade_date, code, 特征列)；完整特征集见 fixtures/gen2/parity_fixture.json",
